# ─────────────────────────────────────────────────────────────
# 1) 프런트엔드(.env.local) — 브라우저에 공개되는 값만
# ─────────────────────────────────────────────────────────────
# 실행 모드(필수): supabase = 실제 연결, demo = 합성 자료만(서버 없음)
#   supabase 모드에서 아래 두 값이 없으면 화면에 설정 오류를 띄우고 멈춘다(데모로 대체하지 않음).
#   데모는 `npm run dev:demo`(.env.demo가 VITE_APP_MODE=demo로 덮어씀)로 따로 실행한다.
VITE_APP_MODE=supabase
# Supabase 프로젝트 URL과 publishable key(sb_publishable_... 또는 레거시 anon key)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# GitHub Pages 하위 경로 배포 시 (기본 /1-9-check/). dev 서버는 항상 /
VITE_BASE_PATH=

# ─────────────────────────────────────────────────────────────
# 2) Edge Function 비밀값 — `supabase secrets set`으로만 설정(파일로 커밋 금지)
#    SUPABASE_URL / SUPABASE_*_KEYS / SUPABASE_SERVICE_ROLE_KEY 는 Supabase가 자동 주입
# ─────────────────────────────────────────────────────────────
# 교사 로그인용 내부 이메일 별칭 도메인(학생은 로그인하지 않음). 운영자가 통제하는 도메인(또는 하위 도메인)을 쓴다.
# 이름·학번과 무관한 무작위 값(u-xxxxxxxx@도메인)으로 만들고, 실제 메일 발송·이메일 복구는 하지 않는다.
ALIAS_EMAIL_DOMAIN=accounts.example-school.kr
# 존재하지 않는 ID에도 같은 형태의 별칭을 돌려주기 위한 HMAC 비밀값(32자 이상 무작위)
LOGIN_ALIAS_PEPPER=
# 함수 호출을 허용할 사이트 주소(쉼표 구분, '*' 불가 — 비우면 브라우저 호출 전부 거절).
# 로컬 실연결 확인용 dev 서버는 4320 포트(.claude/launch.json의 1-9-check-live)
ALLOWED_ORIGINS=http://localhost:4320,http://127.0.0.1:4320,https://suimaire.github.io

# ─────────────────────────────────────────────────────────────
# 3) 최초 교사 계정 스크립트(.env.server) — 운영자 PC에서만, 커밋 금지
# ─────────────────────────────────────────────────────────────
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=        (sb_secret_... 또는 레거시 service_role key)
# SUPABASE_PUBLISHABLE_KEY=   (실연결 검증 스크립트가 공개 제출·교사 세션을 만들 때 사용)
# ALIAS_EMAIL_DOMAIN=         (2)와 같은 값
